#!/usr/bin/env php
<?php

declare(strict_types=1);

$root = dirname(__DIR__);
$autoloadOverride = getenv('RICK_STAND_AUTOLOAD');
$autoload = is_string($autoloadOverride) && is_file($autoloadOverride)
    ? $autoloadOverride
    : $root.'/vendor/autoload.php';
if (! is_file($autoload)) {
    $packageRoot = dirname($root, 2);
    $autoload = $packageRoot.'/vendor/autoload.php';
    if (! is_file($autoload)) {
        fwrite(STDERR, "The test stand is not installed. Run: composer --working-dir=tools/test-stand install\n");
        exit(2);
    }
    putenv('RICK_STAND_PACKAGE_ROOT='.$packageRoot);
}

$loader = require $autoload;
$packageOverride = getenv('RICK_STAND_PACKAGE_ROOT');
if (is_string($packageOverride) && is_dir($packageOverride.'/src')) {
    $loader->addPsr4('Rick\\Laravel\\', $packageOverride.'/src', true);
}
$loader->addPsr4('Rick\\Stand\\', $root.'/src', true);
$loader->addPsr4('Rick\\Stand\\Tests\\', $root.'/tests', true);

exit((new Rick\Stand\Console\Application($root))->run(array_slice($argv, 1)));
